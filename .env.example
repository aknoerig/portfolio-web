# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=

# Local MongoDB (default). On Heroku this is provided automatically as MONGODB_URI.
MONGO_URI=mongodb://127.0.0.1:27017/andreknoerig

# Admin user password seeded into an empty database on first boot.
# If not set, a random password is generated and printed to stdout.
ADMIN_PASSWORD=

# ── Image uploads (Cloudinary) ────────────────────────────────────────────────
# Required at startup — Keystone throws if unset. For local dev without real
# credentials, use the placeholder value below (uploads will fail, site renders fine).
# Get real credentials from: https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://000000000000000:placeholder_secret@placeholder_cloud

# ── Media embeds (Embedly) ────────────────────────────────────────────────────
# Required at startup — Keystone throws if unset. Placeholder value is fine for
# local dev (embed previews won't resolve, everything else works).
# Note: Embedly API reliability has been reduced since Medium's acquisition.
EMBEDLY_API_KEY=placeholder_embedly_key

# ── Maps (Google) ─────────────────────────────────────────────────────────────
# Optional. Powers location map rendering on Activity detail pages.
GOOGLE_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Required in production for contact form notification emails.
# Keystone v4 uses Mandrill by default; check routes/views/contact.js for details.
MANDRILL_API_KEY=

# ── Analytics (production only) ───────────────────────────────────────────────
# GA4 Measurement ID (format: G-XXXXXXXXXX)
GA_PROPERTY=
GA_DOMAIN=

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# New Relic APM. Leave blank to disable (agent is not loaded when key is absent).
NEW_RELIC_LICENSE_KEY=
